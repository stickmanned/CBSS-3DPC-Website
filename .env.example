# Database (Neon Postgres connection string; include sslmode=require)
DATABASE_URL=

# Canonical application origin, used to build absolute links in emails and in
# the admin pages. Set it to the domain people actually visit -- links are the
# one place a wrong value still shows.
#
# It no longer gates requests. Same-origin is proved from the request itself
# (the browser's Origin must equal the origin it reached), so the API accepts
# every domain the site is served on: apex, www, and the *.vercel.app alias.
# A stale value here used to refuse every submission from the real domain at
# the first line of the upload route. Comma-separated extra origins are
# accepted and only ever widen what is recognised.
APP_ORIGIN=
NEXT_PUBLIC_SITE_URL=

# Auth.js GitHub OAuth
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_TRUST_HOST=

# Queue privacy and abuse-prevention secrets (independent random values, 32+ bytes)
REQUESTER_TOKEN_SECRET=
UPLOAD_TOKEN_SECRET=
RATE_LIMIT_HMAC_SECRET=
# Legacy fallback accepted by the application; prefer RATE_LIMIT_HMAC_SECRET.
QUEUE_IDENTIFIER_HMAC_SECRET=

# Private Cloudflare R2 bucket
# R2_ENDPOINT is optional when R2_ACCOUNT_ID is set.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Resend
RESEND_API_KEY=
QUEUE_EMAIL_FROM=
QUEUE_EMAIL_REPLY_TO=
QUEUE_NOTIFICATION_EMAIL=

# Cloudflare Turnstile (optional, but recommended for production)
# Production fails closed without both keys unless an advisor-approved waiver
# is made explicit with TURNSTILE_DISABLED=true.
#
# The sitekey alone is not enough: every hostname the form is served from must
# also be listed under the widget's Hostname Management in the Cloudflare
# dashboard. A sitekey that works on localhost but is missing the production
# domain there fails with client-side error 110200, and the widget dies with no
# server-side trace. Add the apex domain; subdomains of a listed name are
# covered.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional, and normally left blank. The hostname the request actually arrived
# at is always accepted, which is the check that matters -- it proves the
# challenge was solved on the site now spending the token. This variable only
# ADDS hostnames (comma-separated, no scheme or port), so a stale value can no
# longer reject valid traffic the way a single pinned domain once did.
TURNSTILE_EXPECTED_HOSTNAME=
# Optional, and normally empty. The action the widget stamps is defined once in
# app/lib/security/turnstile-config.ts and imported by both the widget and the
# verifier, so they cannot drift apart. This only ADDS accepted actions.
TURNSTILE_EXPECTED_ACTION=
# Kill switch, honoured by both the browser and the server: the widget stops
# rendering and the token stops being required. Use it to keep taking requests
# while a Turnstile fault is fixed, then turn it back off. The honeypot, fill
# time, form age, rate limits and idempotency key all still apply; the bot
# challenge does not. TURNSTILE_DISABLED is a server-only alias kept for
# existing deployments -- prefer the NEXT_PUBLIC name so both halves agree.
NEXT_PUBLIC_TURNSTILE_DISABLED=false
TURNSTILE_DISABLED=false

# Protects /api/cron/maintenance. Generate a separate random value.
CRON_SECRET=

# Optional public build-volume dimensions in millimetres
NEXT_PUBLIC_BUILD_PLATE_X_MM=
NEXT_PUBLIC_BUILD_PLATE_Y_MM=
NEXT_PUBLIC_BUILD_PLATE_Z_MM=

# Used only by npm run seed:admin; keep the GitHub ID as a numeric string.
ADMIN_GITHUB_ID=
ADMIN_GITHUB_LOGIN=
ADMIN_DISPLAY_NAME=

# NODE_ENV, CI, and VERCEL are supplied by Next.js, CI, and Vercel. Do not set them here.
# The backup workflow uses the separate NEON_DATABASE_URL GitHub Actions secret.
